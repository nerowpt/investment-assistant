# Copy to data/accounts/{account_id}/state/controlled_tags.yaml
# Scheme C (O4): system + user + suggested layered vocabulary.
#
# Effective tag ids for library_items.tags_json = enabled(system) + user
# suggested tags MUST be confirmed via CLI before use (promoted to user).

schema_version: 2
scheme: C

rules:
  allow_freeform_tags: false
  freeform_field: user_notes
  max_tags_per_item: 12
  suggested_ttl_days: 90          # unconfirmed suggested tags expire (reserved MVP-2 job)

# Shipped with app / upgraded on release; user may disable but not delete ids
system:
  - id: sector_broker
    label: 券商
    dimension: sector
    enabled: true
  - id: sector_healthcare_device
    label: 医疗器械
    dimension: sector
    enabled: true
