# =============================================================================
# portfolio.yaml 示例（Layer A 当前持仓 SoT）
# =============================================================================
# 复制到：data/accounts/{account_id}/state/portfolio.yaml
# 字段怎么填：docs/manual/ref-portfolio-yaml-fields.md
# 历史流水在 SQLite journals/lots，不要在本文件写「故事」
# =============================================================================

# schema 版本，当前固定 1
schema_version: 1

meta:
  # 最后一次合法写入时间（ISO8601，改文件时记得更新）
  updated_at: "2026-05-19T10:00:00+08:00"
  # 可选：总资产参考值（元），用于从股数推算 position_pct；不用可 null
  total_equity_ref: null
  # 计价货币，默认 CNY
  currency: CNY

positions:
  - # ---------- 身份 ----------
    code: "002624"              # 必填。股票代码，本文件内唯一
    name: 完美世界              # 必填。标的名称

    # state 必填。可选：holding（持有）| closed（已清仓，须 position_pct=0 + closed_at）
    state: holding
    # position_type 必填。可选：core（主仓/长线）| swing（波段/热点副仓）
    position_type: swing

    # ---------- 仓位与成本（数字） ----------
    position_pct: 8             # 必填。当前占总资产 %；= open lot 的 current_pct 之和
    cost_basis: 18.20           # 必填。加权平均成本（元/股）
    shares: 10000               # 可选。持股数量

    sector_id: sector_gaming    # 可选。板块标签 id（controlled_tags.yaml）
    thesis_id: thesis_yihuan_global  # 可选。同一投资逻辑分组 id

    entry_date: 2026-05-18      # 必填。首次进入 holding 的日期 YYYY-MM-DD
    # closed_at: 2026-04-01     # state=closed 时必填

    thesis_version: 2           # 必填。持有逻辑版本，更新 thesis 时 +1
    investment_thesis: |        # 必填。当前持有理由（多行）；不是历史快照
      博弈异环全球化，PC 占比 65%，渠道分成结构优于同业。
      加仓后：测试反馈与海外热度继续验证，未见核心反向证据。

    # target_price 必填。单个数字 或 {lower, upper} 区间
    target_price:
      lower: 32
      upper: 36
    stop_loss: 12.0             # 必填。止损/减仓线（元/股）
    reversal_conditions:        # 必填。逻辑反转条件，至少 1 条
      - 异环 PC 月流水连续 2 月环比 -20% 以上
      - 公司公告异环团队核心人员变动

    # opportunity_cost_benchmark 必填：HS300 | CSI_TECH | sector_index | custom
    opportunity_cost_benchmark: CSI_TECH
    # confidence 可选：low | medium | high
    confidence: medium

    # ---------- 关联 id（通常 approve 后系统写入，手改会被 doctor 报错） ----------
    related_library_ids:        # 可选。支撑逻辑的 L1 素材 id
      - lib_20260518_003
      - lib_20260618_004
    lot_ids:                    # 必填列表。关联 lot_*（含已关闭 lot）
      - lot_20260518_001
      - lot_20260618_001
    journal_ids:                # 必填列表。关联 j_*，按时间追加
      - j_20260518_001
      - j_20260618_002
    watchlist_origin_id: w_20260518_001  # 可选。从观察池升级时的 w_* id
    legacy_flags: []            # 可选。如 legacy_over_limit（存量超限标记）

    # ---------- monitoring 可选：最近一次巡检摘要缓存 ----------
    monitoring:
      last_inspection_id: insp_20260618_001
      last_inspection_at: "2026-06-18T09:00:00+08:00"
      next_inspection_due: 2026-07-18
      # classification 四象限（用户填，非 AI），见 ref-portfolio-yaml-fields.md
      classification: wait_for_style_switch
      # planned_action：hold | add | reduce | exit | keep_watching
      planned_action: hold
    notes: null                 # 可选。自由备注

  # ---------- closed 示例（卖出后保留，勿删记录） ----------
  # - code: "600519"
  #   name: 贵州茅台
  #   state: closed             # closed 必须 position_pct: 0
  #   position_type: core
  #   position_pct: 0
  #   cost_basis: 1680
  #   closed_at: 2026-04-01
  #   entry_date: 2023-01-10
  #   thesis_version: 3
  #   investment_thesis: "..."
  #   target_price: 2200
  #   stop_loss: 1400
  #   reversal_conditions: ["..."]
  #   opportunity_cost_benchmark: HS300
  #   lot_ids: [...]
  #   journal_ids: [...]
